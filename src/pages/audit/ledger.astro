---
import Base from '../../layouts/Base.astro';
import Stat from '../../components/Stat.astro';
import MiniFig from '../../components/MiniFig.astro';
import { number, playbook } from '../../lib/report.js';

const statuses = Object.entries(playbook.statuses).sort((a, b) => b[1] - a[1]);
const areas = Object.entries(playbook.areas).sort((a, b) => b[1] - a[1]);
// Rows, not labels: one qualifier ("DONE (2026-11-03)") can cover several rows.
const qualifiedRows = Object.values(playbook.qualified ?? {}).reduce((a, b) => a + b, 0);
const severity = playbook.severity;
const total = severity ? severity.P1 + severity.P2 + severity.P3 + severity.INFO : 0;
// The band definitions are the source's own words (`.opencode/context.md`, a
// working-tree note). Paraphrasing them would put this audit's reading of P1/P2/P3
// on the page as if it were the project's, so the text is quoted instead.
const legend = playbook.severityLegend ?? {};
const bands = severity
  ? [
      { key: 'P1', count: severity.P1, verdict: 'fails-loud', note: legend.P1 },
      { key: 'P2', count: severity.P2, verdict: 'documented', note: legend.P2 },
      { key: 'P3', count: severity.P3, verdict: 'compiles', note: legend.P3 },
      { key: 'INFO', count: severity.INFO, verdict: 'compiles', note: null },
    ]
  : [];
---

<Base
  title="Ledger — laravel-workers audit"
  description="The shape of the project's own audit ledger: how many suggestions it holds, how the audit's severities distribute, and how many are closed."
  provenance
>
  <section class="section shell">
    <div class="section-head">
      <div>
        <p class="eyebrow">ledger</p>
        <h1>{number(playbook.counts.ledger)} suggestions, {number(playbook.statuses.OPEN ?? 0)} still open, {number(playbook.statuses.DONE ?? 0)} closed</h1>
      </div>
      <p>
        The repository keeps its audit findings, corrections and suggested changes in
        {' '}<code>{playbook.source}</code>. That file is a working-tree note and is{' '}
        <strong>not published in the repository</strong>, so this page republishes only its shape:
        counts, statuses, severities and areas. The item text is deliberately not copied here.
      </p>
    </div>

    <div class="stats">
      <Stat count={playbook.counts.ledger} label="ledger suggestions" />
      <Stat count={playbook.statuses.DONE ?? 0} label="of them closed" verdict="compiles" />
      <Stat count={playbook.statuses.OPEN ?? 0} label="still open" verdict="documented" />
      <Stat count={playbook.citing} label="ledger rows citing a file:line" verdict="compiles" />
    </div>

    <div class="section-head">
      <div>
        <p class="eyebrow">severity</p>
        <h2>The findings concentrate at the bottom</h2>
      </div>
      <p>
        A read-through scratchpad over the tree holds roughly {number(playbook.scratchpadRows)} table
        rows. The bands below are that scratchpad's severity spread, which the source marks with
        {' '}<code>≈</code> - so the total is a shape, not a count of defects. The source's own reading
        of it: the result concentrates in P3/INFO, P1/P2 are real and not zero, but the larger part
        are notes.
      </p>
    </div>

    <div class="table-wrap">
      <table>
        <caption>
          Counts are approximate in the source (<code>≈</code>). Definitions are quoted verbatim from
          <code>.opencode/context.md</code>, another working-tree note, in its own Indonesian; P0 (a
          green build that answers wrongly) is defined there but does not appear in this spread.
        </caption>
        <thead>
          <tr>
            <th scope="col">band</th>
            <th scope="col">rows</th>
            <th scope="col">share</th>
            <th scope="col">the source's own definition of the band</th>
          </tr>
        </thead>
        <tbody>
          {bands.map((band) => (
            <tr>
              <th scope="row" class="mono">{band.key}</th>
              <td class="mono">{number(band.count)}</td>
              <td class="mono">{total ? Math.round((band.count / total) * 100) : 0}%</td>
              <td class="small muted">
                {band.note ?? 'not defined in the source\'s four-band classification'}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <ul class="meter" role="img" aria-label={`Severity spread: ${bands.map((b) => `${b.key} ${b.count}`).join(', ')}`} style="margin-top:1rem">
      {bands.map((band) => (
        <li data-verdict={band.verdict} style={`width:${(band.count / total) * 100}%`}></li>
      ))}
    </ul>
    <ul class="legend">
      {bands.map((band) => <li><span class="mono">{band.key}</span> {number(band.count)}</li>)}
    </ul>
  </section>

  <section class="section shell">
    <div class="section-head">
      <div>
        <p class="eyebrow">suggestions</p>
        <h2>{number(playbook.counts.ledger)} rows, by status and by area</h2>
      </div>
      <div class="section-actions">
        <MiniFig name="status-tally" />
      </div>
      <p>
        Each row is one suggested change with its own risk note and verification recipe. The
        identifiers and statuses below are the ledger's own.
      </p>
    </div>

    <ul class="list">
      <li>
        <div class="list__head">
          <span class="list__title">status</span>
        </div>
        <p class="small">
          {statuses.map(([status, count]) => `${status} ${count}`).join(', ')}, of{' '}
          {number(playbook.counts.ledger)} rows.
        </p>
        {qualifiedRows ? (
          <p class="small muted">
            {number(qualifiedRows)} of those rows carry the ledger's own qualifier
            ({number(Object.keys(playbook.qualified).length)} distinct labels):{' '}
            {Object.entries(playbook.qualified).map(([label, count]) => `${label} (${count})`).join(' · ')}.
          </p>
        ) : null}
      </li>
      <li>
        <div class="list__head">
          <span class="list__title">areas</span>
        </div>
        <p class="small">
          {areas.map(([area, count]) => `${area} ${count}`).join(' · ')}
        </p>
      </li>
      <li>
        <div class="list__head">
          <span class="list__title">rows</span>
        </div>
        <p class="small mono">
          {playbook.rows.map((row) => `${row.id} ${row.status}`).join('   ')}
        </p>
        <p class="small muted">Identifier and status only; the suggestion text stays in the working tree.</p>
      </li>
    </ul>
  </section>

  <section class="section shell">
    <div class="section-head">
      <div>
        <p class="eyebrow">corrections</p>
        <h2>{number(playbook.corrections?.total ?? 0)} claims the ledger itself corrected</h2>
      </div>
      <p>
        The ledger keeps a corrections table for claims that turned out wrong, were refuted, or were
        only partly true. Its rulings, again by shape:
      </p>
    </div>

    <div class="table-wrap">
      <table>
        <caption>Ruling labels are published in Indonesian in the source; the counts are verbatim.</caption>
        <thead>
          <tr>
            <th scope="col">ruling</th>
            <th scope="col">claims</th>
          </tr>
        </thead>
        <tbody>
          {Object.entries(playbook.corrections?.rulings ?? {}).map(([ruling, count]) => (
            <tr>
              <th scope="row" class="mono">{ruling}</th>
              <td class="mono">{count}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>
