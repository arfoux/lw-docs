---
import Base from '../../layouts/Base.astro';
import { report, constructs, docsPages, features, cpuFigures } from '../../lib/report.js';

// The counters table is built by walking report.json rather than by listing what to show,
// so a figure added to the payload appears here without anyone remembering to add a row.
// Arrays are skipped: every array in the payload is a set of rows with a table of its own
// below, and the row tables are driven by the same arrays.
const scalars = (value, prefix = '') =>
  Object.entries(value).flatMap(([key, val]) => {
    const path = prefix ? `${prefix}.${key}` : key;
    if (Array.isArray(val)) return [];
    if (val && typeof val === 'object') return scalars(val, path);
    return [{ path, value: val }];
  });
const counters = [
  ...scalars({ generatedAt: report.generatedAt, generator: report.generator }),
  ...scalars(report.auditedRepo),
  ...scalars(report.headline),
  ...scalars(report.playbook),
];
---

<Base
  title="Every extracted figure — laravel-workers audit"
  description="Every extracted figure and every extracted row on a single page, for reading and for printing."
  provenance
>
  <section class="section shell">
    <div class="section-head">
      <div>
        <p class="eyebrow">full report</p>
        <h1>Everything, on one page</h1>
      </div>
      <p>
        This is the same extracted data as the rest of the site, with nothing hidden behind
        interaction, so the whole thing can be read straight through or printed.
      </p>
    </div>

    <h2>Counters</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th scope="col">figure</th><th scope="col">value</th></tr>
        </thead>
        <tbody>
          {counters.map((row) => (
            <tr>
              <th scope="row" class="mono">{row.path}</th>
              <td class="mono">{String(row.value)}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Census</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th scope="col">construct</th><th scope="col">verdict</th><th scope="col">batch</th><th scope="col">note</th></tr>
        </thead>
        <tbody>
          {constructs.map((row) => (
            <tr>
              <th scope="row" class="mono">{row.label}</th>
              <td class="mono">{row.verdict}</td>
              <td class="mono">{row.batch ?? 'n/a'}</td>
              <td class="small muted">{row.note ?? row.reason ?? ''}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Coverage</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th scope="col">page</th><th scope="col">class</th><th scope="col">planned</th><th scope="col">note</th></tr>
        </thead>
        <tbody>
          {docsPages.map((row) => (
            <tr>
              <th scope="row" class="mono">{row.page}</th>
              <td class="mono">{row.klass}</td>
              <td class="mono">{row.planned ?? 'n/a'}</td>
              <td class="small muted">{row.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Feature map</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th scope="col">area</th><th scope="col">Laravel</th><th scope="col">edge equivalent</th><th scope="col">class</th><th scope="col">plan</th></tr>
        </thead>
        <tbody>
          {features.map((row) => (
            <tr>
              <th scope="row" class="small">{row.area.replace(/\*\*/g, '')}</th>
              <td class="small">{row.laravel}</td>
              <td class="small">{row.edge}</td>
              <td class="mono">{row.klass}</td>
              <td class="mono">{row.plan}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>CPU figures</h2>
    <div class="table-wrap">
      <table>
        <caption>
          Copied from <code>COMPILED.md</code>; the extractor asserts each phrase these were
          transcribed from is still in that file.
        </caption>
        <thead>
          <tr><th scope="col">load</th><th scope="col">p50</th><th scope="col">p95</th><th scope="col">max / kill</th><th scope="col">what it is</th></tr>
        </thead>
        <tbody>
          {cpuFigures.map((row) => (
            <tr>
              <th scope="row">{row.load}</th>
              <td class="mono">{row.p50}</td>
              <td class="mono">{row.p95}</td>
              <td class="mono">{row.max}</td>
              <td class="small muted">{row.note}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <h2>Checks</h2>
    <div class="table-wrap">
      <table>
        <thead>
          <tr><th scope="col">result</th><th scope="col">check</th><th scope="col">detail</th></tr>
        </thead>
        <tbody>
          {report.checks.map((check) => (
            <tr>
              <th scope="row" class="mono">{check.ok ? 'PASS' : 'FAIL'}</th>
              <td class="small">{check.name}</td>
              <td class="small muted mono">{check.detail}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</Base>
