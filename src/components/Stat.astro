---
import { number } from '../lib/report.js';

const { count, verdict, label, note = null, width = '4rem' } = Astro.props;
const colour = { compiles: 'var(--compiles)', 'fails-loud': 'var(--blocked)', documented: 'var(--documented)' }[verdict] ?? 'var(--fg)';
---

<div class="stat" style={`--w:${width}`}>
  <span class="stat__value" style={`color:${colour}`}>{number(count)}</span>
  <span class="stat__label">{label}</span>
  {note && <span class="stat__note">{note}</span>}
</div>

<style>
  .stat {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    min-width: 0;
    border-left: var(--hair) solid var(--line);
    padding-left: 0.7rem;
  }

  .stat__value {
    font-family: var(--mono);
    font-size: var(--step-2);
    font-variant-numeric: tabular-nums;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .stat__label {
    font-size: var(--step--1);
    color: var(--fg-muted);
  }

  .stat__note {
    font-size: var(--step--1);
    color: var(--fg-muted);
    opacity: 0.75;
  }
</style>
