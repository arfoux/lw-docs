};
const { name, size = 20, class: cls = '' } = Astro.props;
const markup = MARKS[name];
if (!markup) throw new Error(`Mark: unknown mark "${name}"`);
---

<svg
  class={`mark ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={markup}
/>
