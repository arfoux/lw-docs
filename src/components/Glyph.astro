---
// A single 24px line-icon set. One geometry: 1.6px stroke, square-ish corners, 45°
// diagonals only — the same construction as the brand mark. Icons are decorative here:
// every one sits beside its own label, so they are aria-hidden by default and never
// carry meaning alone.
const ICONS = {
  compiler: '<path d="M4 4h16v9H4z"/><path d="M9 13v3l3 2 3-2v-3"/><path d="M4 20h16"/>',
  worker: '<path d="M12 3 20 7.5v9L12 21 4 16.5v-9z"/><circle cx="12" cy="12" r="2.2" fill="currentColor" stroke="none"/>',
  edge: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.6 2.4 2.6 14.6 0 17M12 3.5c-2.6 2.4-2.6 14.6 0 17"/>',
  database: '<ellipse cx="12" cy="6" rx="7.5" ry="3"/><path d="M4.5 6v12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3V6"/><path d="M4.5 12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3"/>',
  shield: '<path d="M12 3 19.5 6v6.2c0 4.2-3.1 7.2-7.5 8.8-4.4-1.6-7.5-4.6-7.5-8.8V6z"/><path d="M9 12.4 11.2 15 15.4 9.6"/>',
  lock: '<rect x="5" y="10.5" width="14" height="10" rx="2"/><path d="M8.5 10.5V8a3.5 3.5 0 0 1 7 0v2.5"/><circle cx="12" cy="15.5" r="1.4" fill="currentColor" stroke="none"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7v5.4l3.4 2"/>',
  bolt: '<path d="M13.5 3 5.5 13.5H11L10 21l8.2-10.7H13z"/>',
  layers: '<path d="M12 3.5 20 8l-8 4.5L4 8z"/><path d="M4 12.4 12 17l8-4.6"/><path d="M4 16.6 12 21l8-4.4"/>',
  terminal: '<rect x="3" y="4.5" width="18" height="15" rx="2"/><path d="M7 10l2.5 2.4L7 14.8"/><path d="M12.5 15H17"/>',
  route: '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.5 6h5a3 3 0 0 1 3 3v6.5"/><path d="M15 18H8.5a3 3 0 0 1-3-3V8.5"/>',
  blade: '<path d="M6 3.5h8l4.5 4.5v12.5H6z"/><path d="M14 3.5V8h4.5"/><path d="M9.5 13.5 12 16l5-5.5"/>',
  cache: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5v9M8 11.4l4-3.9 4 3.9"/><path d="M8 16h8"/>',
  storage: '<path d="M4 7.5 12 4l8 3.5v9L12 20l-8-3.5z"/><path d="M4 7.5 12 11l8-3.5M12 11v9"/>',
  mail: '<rect x="3" y="5.5" width="18" height="13" rx="2"/><path d="M3.6 7 12 13l8.4-6"/>',
  list: '<path d="M4 7h16M4 12h16M4 17h10"/><circle cx="19.5" cy="17" r="1.6" fill="currentColor" stroke="none"/>',
  check: '<circle cx="12" cy="12" r="8.5"/><path d="M8.4 12.4 11 15l4.8-6"/>',
  warn: '<path d="M12 4 21 19.5H3z"/><path d="M12 9.5v5"/><circle cx="12" cy="17" r="1" fill="currentColor" stroke="none"/>',
  tree: '<path d="M5 4.5h5v4H5zM14 4.5h5v4h-5zM14 15.5h5v4h-5z"/><path d="M7.5 8.5v5h9v2"/><path d="M5 18H2.5"/>',
  bundle: '<path d="M12 3.5 6 7v10l6 3.5 6-3.5V7z"/><path d="M12 10.5V21M6 7l6 3.5L18 7"/>',
  cron: '<circle cx="12" cy="12.5" r="7"/><path d="M12 8.5v4.6l3 1.8"/><path d="M4.5 4.5 7 2.5M19.5 4.5 17 2.5"/>',
  session: '<circle cx="12" cy="12" r="8.5"/><circle cx="10" cy="10" r="1.3" fill="currentColor" stroke="none"/><circle cx="14.5" cy="13.5" r="1.3" fill="currentColor" stroke="none"/><circle cx="10" cy="15" r="1.3" fill="currentColor" stroke="none"/>',
  upload: '<path d="M12 4v10M8 8.5 12 4.5l4 4"/><path d="M4.5 15v3.5h15V15"/>',
  policy: '<path d="M6 3.5h9l4.5 4.5v12.5H6z"/><path d="M15 3.5V8h4.5"/><path d="M9 13.5h6M9 16.5h4"/>',
  event: '<circle cx="12" cy="12" r="2.2" fill="currentColor" stroke="none"/><path d="M8.2 8.2a5.4 5.4 0 0 0 0 7.6M15.8 15.8a5.4 5.4 0 0 0 0-7.6"/><path d="M5.4 5.4a9.4 9.4 0 0 0 0 13.2M18.6 18.6a9.4 9.4 0 0 0 0-13.2"/>',
  arrow: '<path d="M4 12h15"/><path d="M13 6l6 6-6 6"/>',
  request: '<path d="M4 8h10"/><path d="M18 8h2M4 16h6"/><path d="M14 16h6"/><path d="M11 5.5 14.5 8 11 10.5"/><path d="M18 13.5 21.5 16 18 18.5"/>',
  code: '<path d="M9 8.5 5 12l4 3.5M15 8.5 19 12l-4 3.5"/><path d="M13 6l-2 12"/>',
};
const { name, size = 24, class: cls = '' } = Astro.props;
const markup = ICONS[name];
if (!markup) throw new Error(`Glyph: unknown icon "${name}"`);
---

<svg
  class={`glyph ${cls}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={markup}
/>
