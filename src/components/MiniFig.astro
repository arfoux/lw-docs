---
// Small diagrams. The hero figure explains the whole pipeline; these explain one idea
// each, where the prose would otherwise be a wall of text. Same construction as the hero:
// flat nodes, hairline edges, mono labels, no animation — a figure that cannot be read in
// a screenshot is not finished.
//
// The SVG is decorative (`aria-hidden`); the <figcaption> is the accessible description,
// so the meaning survives with the image gone.
const NODE_H = 26;

const node = (x, y, w, text, sub = null, tone = '') =>
  `<g class="f-node ${tone}"><rect x="${x}" y="${y}" width="${w}" height="${NODE_H}" rx="4"/>` +
  `<text class="f-m" x="${x + 10}" y="${y + (sub ? 12 : 17)}">${text}</text>` +
  (sub ? `<text class="f-s" x="${x + 10}" y="${y + 23}">${sub}</text>` : '') +
  '</g>';

const edge = (x1, y1, x2, y2, dashed = false) =>
  `<path class="f-edge${dashed ? ' f-edge--dash' : ''}" d="M${x1} ${y1}H${x2 === x1 ? x2 : x2}V${y2}"/>`;

const arrow = (x1, y1, x2, y2) => `<path class="f-arrow" d="M${x1} ${y1}H${x2}V${y2}" marker-end="url(#f-tip)"/>`;

const defs = `<defs><marker id="f-tip" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto"><path d="M0 0l8 4-8 4z" fill="currentColor"/></marker></defs>`;

const label = (x, y, text, tone = '') => `<text class="f-l ${tone}" x="${x}" y="${y}">${text}</text>`;

const FIGS = {
