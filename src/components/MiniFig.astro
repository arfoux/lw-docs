// The component refuses to emit a diagram whose own geometry leaves its canvas: a text
// label running past the right edge, or a node whose bottom falls outside the viewBox, is
// a figure that will be clipped on the page and never noticed in a screenshot review.
// Widths are estimated per class (mono text is wider than sans at the same size), which is
// deliberately conservative: the check would rather complain early than ship a clip.
const PER_CHAR = { 'f-m': 6.7, 'f-l': 6.0, 'f-s': 5.1, 'f-s--muted': 5.1, 'f-m--ok': 6.7, 'f-m--warn': 6.7 };
const fitProblems = [];

const estimate = (cls, text) => {
  const key = Object.keys(PER_CHAR).find((k) => cls.split(/\s+/).includes(k)) ?? 'f-l';
  return text.length * PER_CHAR[key];
};

const checkFigure = (figureName, figure) => {
  const markup = defs + figure.body;
  for (const match of markup.matchAll(/<text class="([^"]*)" x="([-\d.]+)" y="([-\d.]+)"[^>]*>([^<]*)<\/text>/g)) {
    const [, cls, x, y, text] = match;
    const right = Number(x) + estimate(cls, text);
    if (right > figure.w - 1) fitProblems.push(`${figureName}: text "${text}" ends at ${Math.round(right)} beyond ${figure.w}`);
    if (Number(y) > figure.h - 2) fitProblems.push(`${figureName}: text "${text}" sits at y=${y} beyond ${figure.h}`);
  }
  for (const match of markup.matchAll(/<rect x="([-\d.]+)" y="([-\d.]+)" width="([-\d.]+)" height="([-\d.]+)"/g)) {
    const [, x, y, w, h] = match.map(Number);
    if (x + w > figure.w + 1) fitProblems.push(`${figureName}: a node ends at x=${x + w} beyond ${figure.w}`);
    if (y + h > figure.h + 1) fitProblems.push(`${figureName}: a node ends at y=${y + h} beyond ${figure.h}`);
  }
};

for (const [figureName, figure] of Object.entries(FIGS)) checkFigure(figureName, figure);
if (fitProblems.length) throw new Error(`MiniFig geometry: ${fitProblems.join('; ')}`);

const { name } = Astro.props;
const fig = FIGS[name];
if (!fig) throw new Error(`MiniFig: unknown figure "${name}"`);
---

<figure class="mini-fig">
  <div class="mini-fig__frame" style={`aspect-ratio:${fig.w}/${fig.h}`}>
    <svg
      class="mini-fig__svg"
      viewBox={`0 0 ${fig.w} ${fig.h}`}
      preserveAspectRatio="xMinYMin meet"
      aria-hidden="true"
      focusable="false"
      set:html={defs + fig.body}
    />
  </div>
  <figcaption>{fig.caption}</figcaption>
</figure>
