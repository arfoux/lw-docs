---
// The hero figure, redrawn as an editorial three-stage schematic: source → build →
// artifact. One accent (the compiled tier), 1px rules, no shadow, no gradient, and
// every structural coordinate on the 4px grid. Icons are inert line glyphs beside
// their own labels; the static frame is the whole figure, and the loop only shows
// traffic moving through it.
const ICON = {
  route: '<circle cx="6" cy="6" r="2.5"/><circle cx="18" cy="18" r="2.5"/><path d="M8.5 6h5a3 3 0 0 1 3 3v6.5"/><path d="M15 18H8.5a3 3 0 0 1-3-3V8.5"/>',
  compiler: '<path d="M4 4h16v9H4z"/><path d="M9 13v3l3 2 3-2v-3"/><path d="M4 20h16"/>',
  layers: '<path d="M12 3.5 20 8l-8 4.5L4 8z"/><path d="M4 12.4 12 17l8-4.6"/><path d="M4 16.6 12 21l8-4.4"/>',
  blade: '<path d="M6 3.5h8l4.5 4.5v12.5H6z"/><path d="M14 3.5V8h4.5"/><path d="M9.5 13.5 12 16l5-5.5"/>',
  database: '<ellipse cx="12" cy="6" rx="7.5" ry="3"/><path d="M4.5 6v12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3V6"/><path d="M4.5 12c0 1.7 3.4 3 7.5 3s7.5-1.3 7.5-3"/>',
  camera: '<path d="M4 8.5h3l1.6-2.5h6.8L17 8.5h3v10H4z"/><circle cx="12" cy="13.5" r="3.2"/>',
  bolt: '<path d="M13.5 3 5.5 13.5H11L10 21l8.2-10.7H13z"/>',
  plug: '<path d="M9 3.5v5M15 3.5v5"/><path d="M6.5 8.5h11v3a5.5 5.5 0 0 1-11 0z"/><path d="M12 17v3.5"/>',
  file: '<path d="M6 3.5h8l4.5 4.5v12.5H6z"/><path d="M14 3.5V8h4.5"/>',
  edge: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.6 2.4 2.6 14.6 0 17M12 3.5c-2.6 2.4-2.6 14.6 0 17"/>',
  worker: '<path d="M12 3 20 7.5v9L12 21 4 16.5v-9z"/><circle cx="12" cy="12" r="2.2" fill="currentColor" stroke="none"/>',
};

// 24px box, translated into place, currentColor so the CSS owns the ink.
const icon = (name, x, y, scale = 1) =>
  `<g transform="translate(${x} ${y}) scale(${scale})" fill="none" stroke="currentColor" ` +
  `stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICON[name]}</g>`;

const files = [
  { name: 'routes/web.php', icon: 'route' },
  { name: 'app/Http/Controllers/PostController.php', icon: 'compiler' },
  { name: 'app/Models/Post.php', icon: 'layers' },
  { name: 'resources/views/posts/show.blade.php', icon: 'blade' },
  { name: 'database/migrations/2026_10_01_posts.php', icon: 'database' },
];

const phases = [
  { name: 'schema', icon: 'database', out: 'migrations → CREATE DDL', boot: '1 boot', x: 432, y: 112 },
  { name: 'views', icon: 'blade', out: 'blade → js render(ctx)', boot: '1 boot', x: 600, y: 112 },
  { name: 'snapshots', icon: 'camera', out: 'clean GETs → HTML', boot: '0–1 boot', x: 432, y: 200 },
  { name: 'metadata', icon: 'route', out: 'route table + census', boot: '0–1 boot', x: 600, y: 200 },
];

const tiers = [
  { name: 'static', icon: 'file', value: '0 invocations', y: 136 },
  { name: 'snapshot', icon: 'camera', value: 'prerendered', y: 192 },
  { name: 'compiled', icon: 'bolt', value: 'p95 ≤ 5 ms', y: 248, focal: true },
  { name: 'port', icon: 'plug', value: 'hand-written', y: 304 },
];
---

<figure class="pipeline">
  <svg class="pipeline__svg" viewBox="0 0 1160 468" role="img" aria-labelledby="pipeline-title pipeline-desc">
    <title id="pipeline-title">Laravel source is compiled at build time into one Worker module</title>
    <desc id="pipeline-desc">
      Three stages on one rail. Left: five Laravel files — routes, controller, model, Blade view
      and migration. Middle: the build, where PHP 8.3 boots once per phase (schema, views,
      snapshots, metadata) and translates source to JavaScript. Right: one dist/worker.mjs on
      Cloudflare Workers, answered as a static file, a snapshot, a compiled handler or a port.
      The compiled tier is the focal element. The static frame carries the whole meaning; the
      animation only shows traffic moving through it.
    </desc>

    <defs>
      <marker id="pl-tip" viewBox="0 0 8 8" refX="6" refY="4" markerWidth="6" markerHeight="6" orient="auto">
        <path class="pl-tip" d="M0 0l8 4-8 4z" />
      </marker>
    </defs>

    <g class="pl-zone" aria-hidden="true">
      <line x1="400" y1="24" x2="400" y2="444" />
      <line x1="780" y1="24" x2="780" y2="444" />
    </g>

    <!-- Arrows first, so every line sits behind the boxes it connects. -->
    <g class="pl-flow" aria-hidden="true">
      <path d="M384 224h24" marker-end="url(#pl-tip)" />
      <path d="M768 224h24" marker-end="url(#pl-tip)" />
      <circle class="pl-packet pl-packet--a" cx="384" cy="224" r="4" />
      <circle class="pl-packet pl-packet--b" cx="768" cy="224" r="4" />
    </g>

    <!-- LEFT: the source of truth, one neutral node per file. -->
    <text class="pl-label" x="24" y="32">your laravel app</text>
    <text class="pl-sub" x="24" y="52">the source of truth — untouched</text>
    <g class="pl-files">
      {files.map((f, i) => (
        <g class="pl-file" style={`--i:${i}`}>
          <rect x="24" y={72 + i * 52} width="360" height="44" rx="4" />
          <Fragment set:html={icon(f.icon, 36, 82 + i * 52)} />
          <text class="pl-mono" x="76" y={100 + i * 52}>{f.name}</text>
        </g>
      ))}
    </g>

    <!-- MIDDLE: one container, four phase nodes, one cut strip. -->
    <text class="pl-label" x="416" y="32">build time · php 8.3</text>
    <text class="pl-sub" x="416" y="52">boots once per phase, never per request</text>
    <rect class="pl-press" x="416" y="96" width="352" height="228" rx="6" />

    {phases.map((p, i) => (
      <g class="pl-phase" style={`--i:${i}`}>
        <rect x={p.x} y={p.y} width="152" height="72" rx="4" />
        <Fragment set:html={icon(p.icon, p.x + 12, p.y + 12)} />
        <text class="pl-phase__name" x={p.x + 44} y={p.y + 28}>{p.name}</text>
        <text class="pl-sub2" x={p.x + 12} y={p.y + 56}>{p.out}</text>
        <text class="pl-tag" x={p.x + 140} y={p.y + 28} text-anchor="end">{p.boot}</text>
      </g>
    ))}

    <g class="pl-cut" aria-hidden="true">
      <line x1="432" y1="292" x2="752" y2="292" />
      {[0, 1, 2, 3].map((i) => (
        <rect class="pl-token" style={`--i:${i}`} x={440 + i * 32} y="300" width="8" height="8" rx="2" />
      ))}
      <text class="pl-sub2" x="432" y="316">blade → php → js · byte-parity vs php 8.3</text>
    </g>
    <line class="pl-scan" x1="432" y1="112" x2="752" y2="112" aria-hidden="true" />

    <!-- RIGHT: one bundle, four tiers, one edge rail. Only 'compiled' is focal. -->
    <text class="pl-label" x="792" y="32">cloudflare workers</text>
    <text class="pl-sub" x="792" y="52">one ESM bundle · v8 isolates</text>

    <g class="pl-bundle">
      <rect x="792" y="72" width="344" height="48" rx="4" />
      <Fragment set:html={icon('worker', 808, 84)} />
      <text class="pl-mono" x="848" y="92">dist/worker.mjs</text>
      <text class="pl-tag" x="1124" y="92" text-anchor="end">JS</text>
      <text class="pl-sub2" x="848" y="108">static assets + handlers + schema.sql</text>
    </g>

    <g class="pl-tiers">
      {tiers.map((t) => (
        <g class={`pl-tier${t.focal ? ' pl-tier--focal' : ''}`}>
          <rect x="792" y={t.y} width="344" height="48" rx="4" />
          <Fragment set:html={icon(t.icon, 808, t.y + 12)} />
          <text class="pl-mono" x="848" y={t.y + 28}>{t.name}</text>
          <text class="pl-tag" x="1124" y={t.y + 28} text-anchor="end">{t.value}</text>
        </g>
      ))}
    </g>

    <g class="pl-edge">
      <rect x="792" y="368" width="344" height="48" rx="4" />
      <Fragment set:html={icon('edge', 808, 380)} />
      <text class="pl-sub2" x="848" y="396">edge · request in, handler out</text>
    </g>
  </svg>

  <!-- A phone cannot read a 1160-unit diagram at 390px. The same three stages, stacked. -->
  <ol class="pipeline__mobile">
    <li>
      <span class="pl-m">your laravel app</span>
      <span class="pl-m2">routes, controller, model, view, migration — untouched</span>
    </li>
    <li>
      <span class="pl-m">build time · php 8.3</span>
      <span class="pl-m2">schema · views · snapshots · metadata — one boot per phase</span>
    </li>
    <li>
      <span class="pl-m">cloudflare workers</span>
      <span class="pl-m2">dist/worker.mjs → static, snapshot, compiled p95 ≤ 5 ms, port</span>
    </li>
  </ol>

  <figcaption class="pipeline__cap">
    <span><strong>build</strong> PHP runs here, once per phase that has work</span>
    <span><strong>artifact</strong> assets, snapshots, compiled handlers, ports</span>
    <span><strong>runtime</strong> no PHP, no WASM, no boot per request</span>
  </figcaption>
</figure>
