{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "laravel-workers-report",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-05",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "lw.nietzsc.de", "custom_domain": true }
  ],
  "observability": {
    "enabled": false
  }
}

